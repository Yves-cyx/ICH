<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ICH" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ich_red</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/ich_paper</item>
    </style>
    <style name="IchHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ich_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="IchBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ich_ink</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>
</resources>
