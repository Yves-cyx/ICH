<resources>
    <style name="Theme.Yingjian.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/brand_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/brand_card</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">@bool/use_dark_system_bar_icons</item>
    </style>
    <style name="Theme.Yingjian" parent="Theme.Yingjian.Base">
        <item name="android:navigationBarColor">@color/legacy_navigation_bar</item>
    </style>
    <style name="Feiyi.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Feiyi.Copy" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Feiyi.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/brand_card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
