<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_page" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/IchHeading" android:text="@string/profile_title" />
        <TextView style="@style/IchBody" android:text="@string/profile_intro" />
        <Button
            android:id="@+id/open_login"
            style="@style/IchAction"
            android:text="@string/login_title" />

        <Button
            android:id="@+id/open_favorites"
            style="@style/IchAction"
            android:text="@string/favorites_title" />

        <Button
            android:id="@+id/open_works"
            style="@style/IchAction"
            android:text="@string/works_title" />

        <Button
            android:id="@+id/open_settings"
            style="@style/IchAction"
            android:text="@string/settings_title" />
    </LinearLayout>
</ScrollView>
