<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Feiyi.Headline"
            android:layout_marginTop="4dp"
            android:text="@string/stage_title" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Feiyi.Copy"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:text="@string/stage_copy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.card.MaterialCardView
                style="@style/Feiyi.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.yingjian.feiyi.ui.ShadowArtView
                    android:id="@+id/stage_view"
                    android:layout_width="match_parent"
                    android:layout_height="236dp"
                    android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/stage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stage" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/gallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/create"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:id="@+id/light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/light_toggle"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/characters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/shape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="5dp">
                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:id="@+id/scholar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scholar"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:id="@+id/warrior"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/warrior"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:id="@+id/lady"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lady"
                    android:checkable="true" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/gallery_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Feiyi.Copy"
                android:layout_marginTop="7dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="5dp">
                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:id="@+id/cinnabar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cinnabar"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:id="@+id/indigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/indigo"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:id="@+id/amber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amber"
                    android:checkable="true" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.TextButton"
                    android:id="@+id/move_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/move_left"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.TextButton"
                    android:id="@+id/move_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/move_right"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.TextButton"
                    android:id="@+id/move_up"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/move_up"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.TextButton"
                    android:id="@+id/move_down"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/move_down"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Feiyi.Copy"
                android:text="@string/rotation" />

            <com.google.android.material.slider.Slider
                android:id="@+id/rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-45"
                android:valueTo="45"
                android:stepSize="1"
                android:contentDescription="@string/rotation" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:id="@+id/work_name_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/work_name"
                android:layout_marginTop="3dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/work_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="32"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:id="@+id/save_work"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_work"
                android:layout_marginTop="9dp" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.TextButton"
                android:id="@+id/new_work"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_work" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
